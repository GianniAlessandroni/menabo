EMAIL_ADDRESS=cronista@redazione.local
EMAIL_PASSWORD=change-me-3
EMAIL_IMAP_HOST=mail-server
EMAIL_IMAP_PORT=143
EMAIL_SMTP_HOST=mail-server
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=30

# Receive allow-list: peers + caporedattore + director + bounces
EMAIL_ALLOWED_USERS=caporedattore@redazione.local,verificatore@redazione.local,art-director@redazione.local,impaginatore@redazione.local,gianni@redazione.local,mailer-daemon@redazione.local,mailer-daemon@mail.redazione.local

OPENAI_API_KEY=none
API_SERVER_PORT=4002

# Garage S3: key scoped to the `bozze` bucket (setup-storage.sh prints it)
AWS_ACCESS_KEY_ID=GK-change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=garage
AWS_ENDPOINT_URL=http://garage:3900
