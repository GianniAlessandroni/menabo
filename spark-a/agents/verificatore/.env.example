EMAIL_ADDRESS=verificatore@redazione.local
EMAIL_PASSWORD=change-me-4
EMAIL_IMAP_HOST=mail-server
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail-server
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=30

EMAIL_ALLOWED_USERS=caporedattore@redazione.local,cronista@redazione.local,art-director@redazione.local,impaginatore@redazione.local,gianni@redazione.local,mailer-daemon@redazione.local,mailer-daemon@mail.redazione.local

OPENAI_API_KEY=none
API_SERVER_PORT=4003

# Verifier endpoint on node B (multimodal Qwen3.6-27B)
VERIFIER_BASE_URL=http://192.168.1.102:8000/v1

# Garage S3: read-only key for `bozze` + `immagini` (setup-storage.sh prints it)
AWS_ACCESS_KEY_ID=GK-change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=garage
AWS_ENDPOINT_URL=http://garage:3900
