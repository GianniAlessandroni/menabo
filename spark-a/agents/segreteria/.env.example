EMAIL_ADDRESS=segreteria@redazione.local
EMAIL_PASSWORD=change-me-7
EMAIL_IMAP_HOST=mail-server
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail-server
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=30

# Phase 1-2: only the caporedattore and the director may address it
EMAIL_ALLOWED_USERS=caporedattore@redazione.local,gianni@redazione.local,mailer-daemon@redazione.local,mailer-daemon@mail.redazione.local

OPENAI_API_KEY=none
API_SERVER_PORT=4006

# Verifier endpoint on node B (reached over the LAN from frontier-net)
VERIFIER_BASE_URL=http://192.168.1.102:8000/v1
