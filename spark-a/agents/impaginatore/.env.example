EMAIL_ADDRESS=impaginatore@redazione.local
EMAIL_PASSWORD=change-me-6
EMAIL_IMAP_HOST=mail-server
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail-server
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=30

EMAIL_ALLOWED_USERS=caporedattore@redazione.local,cronista@redazione.local,verificatore@redazione.local,art-director@redazione.local,gianni@redazione.local,mailer-daemon@redazione.local,mailer-daemon@mail.redazione.local

OPENAI_API_KEY=none
API_SERVER_PORT=4005

# base64("impaginatore:<application password>") — setup-wordpress.sh prints it
WORDPRESS_MCP_BASIC_AUTH=aW1wYWdpbmF0b3JlOmNoYW5nZS1tZQ==

# Garage S3: read-only key for `bozze` + `immagini` (setup-storage.sh prints it)
AWS_ACCESS_KEY_ID=GK-change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=garage
AWS_ENDPOINT_URL=http://garage:3900
