# =============================================================================
#  menabò — an experiment in human-agent newsroom integration
# -----------------------------------------------------------------------------
#  File:     spark-a/agents/caporedattore/.env.example
#  Purpose:  Hermes environment for the caporedattore container. Copy to
#            .env (gitignored) and align passwords with spark-a/.env.
#  Author:   Gianni Alessandroni
#  Created:  2026-08-16
#  License:  Apache-2.0 — see LICENSE
#  Part of:  menabò https://github.com/GianniAlessandroni/menabo
# =============================================================================

# Email gateway (IMAP polling + SMTP replies), cleartext on the isolated net
EMAIL_ADDRESS=caporedattore@redazione.local
EMAIL_PASSWORD=change-me-2
EMAIL_IMAP_HOST=mail-server
EMAIL_IMAP_PORT=143
EMAIL_SMTP_HOST=mail-server
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=30

# Receive allow-list: the caporedattore hears everyone, plus bounces
EMAIL_ALLOWED_USERS=gianni@redazione.local,cronista@redazione.local,verificatore@redazione.local,art-director@redazione.local,impaginatore@redazione.local,segreteria@redazione.local,postmaster@redazione.local,mailer-daemon@redazione.local,mailer-daemon@mail.redazione.local

# Writer endpoint needs no key; the variable must still exist
OPENAI_API_KEY=none

# One distinct port per agent container (Hermes internal API server)
API_SERVER_PORT=4001

# Garage S3: key scoped to the `piani` bucket only (setup-storage.sh prints it)
AWS_ACCESS_KEY_ID=GK-change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=garage
AWS_ENDPOINT_URL=http://garage:3900
