# =============================================================================
#  menabò — an experiment in human-agent newsroom integration
# -----------------------------------------------------------------------------
#  File:     spark-a/mail-server/config/dovecot.cf
#  Purpose:  Dovecot override: keep cleartext IMAP auth allowed on 143 for
#            the director and the smoke test; agents use TLS on 993.
#  Author:   Gianni Alessandroni
#  Created:  2026-08-16
#  License:  Apache-2.0 — see LICENSE
#  Part of:  menabò https://github.com/GianniAlessandroni/menabo
# =============================================================================

# why: dual-mode IMAP (see RUNBOOK §7) — the Hermes email adapter polls
# 993 (implicit TLS, internal CA), while 143 stays cleartext-capable for
# the director's LAN client and the smoke test on the isolated network.
# note: Dovecot 2.3 name (DMS 15.1.0 ships 2.3.19); the 2.4+ rename
# `auth_allow_cleartext` is unknown there and doveconf dies on it.
disable_plaintext_auth = no

# why: DMS forces `ssl = required` whenever SSL_TYPE is set, which rejects
# cleartext auth on 143 with [PRIVACYREQUIRED] no matter what the setting
# above says; `yes` keeps 993/STARTTLS served AND the cleartext path open.
ssl = yes
